PORT=5000
NODE_ENV=development
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://showroom_app:change-me@localhost:5432/showroom
# Use disable only for localhost or the Railway private network when required.
# Public endpoints: verify-full (default), with a trusted CA file if needed.
DATABASE_SSL=disable
DATABASE_POOL_MAX=5
# DATABASE_SSL_CA_FILE=/path/to/ca.pem
# Optional privileged URL used only by db:migrate/data, not by the API.
# MIGRATION_DATABASE_URL=postgresql://migration-user:password@host:5432/showroom

# Keep the existing production JWT_SECRET during migration.
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
WRITE_MAINTENANCE=false

STORAGE_PROVIDER=r2
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET=motorcycle-images
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_PUBLIC_BASE_URL=https://images.your-domain.com

# Only for source export/copy or transitional DATABASE_PROVIDER/STORAGE_PROVIDER=supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-backend-service-role-key
SUPABASE_STORAGE_BUCKET=motorcycle-images

# Separate backup job only; never expose these variables to the frontend.
# BACKUP_DATABASE_URL=postgresql://showroom_backup:change-me@postgres.railway.internal:5432/showroom
# BACKUP_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# BACKUP_BUCKET=3sgo-database-backups
# BACKUP_ACCESS_KEY_ID=replace-me
# BACKUP_SECRET_ACCESS_KEY=replace-me
# BACKUP_ENCRYPTION_KEY=<base64-encoded-32-random-bytes>
# RESTORE_DATABASE_URL=postgresql://migration-user:change-me@localhost:5432/new_empty_restore
